{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsEnvironmentStage",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::976610556545:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:ChristianRuiz2025/calendario-guardias-2026:environment:stage"
        }
      }
    }
  ]
}
