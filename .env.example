# Variables de entorno (configurar en Vercel > Settings > Environment Variables).
# Todas son solo del servidor: ninguna lleva el prefijo VITE_.

# Base de datos MySQL (AWS RDS)
MYSQL_HOST=TU-ENDPOINT.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=guardias
# rds (por defecto, SSL validando el certificado de Amazon RDS) | on | off (solo pruebas locales)
MYSQL_SSL=rds

# Firma de las sesiones: texto largo y aleatorio (p. ej. openssl rand -hex 32)
SESSION_SECRET=

# API /api/auditorias
AUDITORIAS_API_KEY=

# API /api/enviar-mes
MAIL_FROM=soportecesa@compusoluciones.com
# Microsoft Graph (recomendado): app de Azure con permiso de aplicacion Mail.Send
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# O SMTP, si no se usa Graph (por defecto smtp.office365.com y 587)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
