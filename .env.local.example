# Copiar a .env.local para desarrollo con la BD de Docker (npm run dev:db).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=guardias_app
MYSQL_PASSWORD=guardias-local
MYSQL_DATABASE=guardias
MYSQL_SSL=off

SESSION_SECRET=solo-para-desarrollo-local-cambiar-en-aws
AUDITORIAS_API_KEY=clave-local

# Correo (opcional en local): sin esto /api/enviar-mes responde que falta configurarlo.
MAIL_FROM=
SMTP_USER=
SMTP_PASS=
